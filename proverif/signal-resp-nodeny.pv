(*
  PQXDH + Triple Ratchet; proving no offline deniability for the responder
  Author: Jake Ginesin

  model assumption #1: authentication for the first message holds, and is thus omitted from this model. authentication was proved standalone in `pqxdh.pv`
*)

free m1: bitstring [private].
free m2: bitstring [private].
free empty: bitstring.
fun okay():bitstring.

set attacker = passive.
set selFun = Nounifset.
set simplifyProcess = false.
set ignoreTypes = false.
set redundantHypElim = true.
set redundancyElim = best.
set movenew = true.
set nounifIgnoreAFewTimes = auto.
(*
set simpEqAll = false.
set simpEqAll = false.
set redundancyElim = best.
set redundantHypElim = true.
set simplifyProcess = true.
set stopTerm = false.
*)

nounif z: skey; attacker(pk(z)) / 10000.
nounif x: pkey, y: skey; attacker(dh(x,y)) / 5000.
nounif z: skey; attacker(pk(z)) phase 1 / 5000.
nounif z: skey; attacker(pk(z)) phase 2 / 5000.
nounif z: skey; attacker(pk(z)) phase 3 / 5000.

free c: channel.
free a: channel. (* channel for the attacker *)

(* Symmetric key encryption *)

type key.

fun aead_enc(key, bitstring, bitstring): bitstring.
reduc forall k: key, m: bitstring, ad: bitstring;
  aead_check(k, aead_enc(k, m, ad), ad) = okay.
reduc forall k: key, m: bitstring, ad: bitstring;
  aead_dec(k, aead_enc(k, m, ad), ad) = m.

(* Asymmetric key encryption *)

type skey.
type pkey.

fun rb(pkey): bitstring [data]. (* translate a public key to a bitstring *)
fun pk(skey): pkey.

(* Digital signatures *)

fun sign(skey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey; checksign(pk(sk), m, sign(sk, m)) = okay.

(* Diffie-Hellman *)
(* DH -> Public^Private *)

fun dh(pkey, skey): key.
equation forall a: skey, b: skey; dh(pk(a), b) = dh(pk(b), a). (* symmetry of DH *)

(* Key derivation functions *)
fun hkdf1(key, key, key, key, bitstring): key.

fun hkdf2_dev1(key): key.
fun hkdf2_dev2(key): key.
letfun hkdf2(k: key) =
  (hkdf2_dev1(k), hkdf2_dev2(k)).

fun hkdf3_dev1(key, bitstring): key.
fun hkdf3_dev2(key, bitstring): key.
letfun hkdf3(k: key, s: bitstring) =
  (hkdf3_dev1(k, s), hkdf3_dev2(k, s)).

fun hkdf4_dev1(key, key): key.
fun hkdf4_dev2(key, key): key.
letfun hkdf4(k1: key, k2: key) =
  (hkdf4_dev1(k1, k2), hkdf4_dev2(k1, k2)).

fun hkdf5(key, key): key.

fun concat1(pkey, pkey): bitstring [data].

(* KEM encapsulation *)
type kempriv.
type kempub.

fun kempk(kempriv):kempub.
fun penc(kempub, bitstring):bitstring.
(* fun pdec(kempriv,bitstring):bitstring. *)
reduc forall sk: kempriv, m:bitstring; pdec(sk, penc(kempk(sk), m)) = m.

letfun kempriv2pub(k:kempriv) = kempk(k).

letfun pqkem_enc(pk:kempub) =
       new ss:bitstring;
       (penc(pk,ss),ss).

letfun pqkem_dec(sk:kempriv,ct:bitstring) =
       pdec(sk,ct).

fun qb(kempub): bitstring [data].

fun concat2(bitstring, pkey, kempub): bitstring [data].
fun concat3(bitstring, pkey, bitstring): bitstring [data].

(* events *)
event sendE1(bitstring, key).
event recvE1(bitstring, key).
event sendE2(bitstring, key).
event recvE2(bitstring, key).

event compromiseSKA(skey).
event compromiseSKB(skey).
event breakDH(key, key, key, key).
event masterLeak(key).

event start().

let PeerA(SK_A: skey, PK_A: pkey, PK_B: pkey) =

  new ae1: skey;
  new ae2: skey;
  new pqae2: kempriv;
  let gae1 = pk(ae1) in
  let gae2 = pk(ae2) in
  let gpqae2 = kempk(pqae2) in

  (* generate amaster and enc msg (PHASE 1) *)
  phase 1;

  in(c, (gbssig: bitstring, gbs: pkey, gbo: pkey, gpqbo: kempub, gpqbsig: bitstring));
  if checksign(PK_B, rb(gbs), gbssig) = okay then
  if checksign(PK_B, qb(gpqbo), gpqbsig) = okay then
  let (ct: bitstring, ss: bitstring) = pqkem_enc(gpqbo) in

  let amaster = hkdf1(dh(gbs, SK_A), dh(PK_B, ae1), dh(gbs, ae1), dh(gbo, ae1), ss) in
  let (ra1: key, ca1: key) = hkdf2(amaster) in (* derive the root and chain key *)

  let x1 = aead_enc(ca1, m1, concat2(concat1(PK_A, PK_B), gae2, gpqae2)) in
  event sendE1(m1, ca1);

  out(c, (x1, gae1, gae2, gpqae2, ct));

  (* second stage *)

  in(c, (x2: bitstring, gtb2: pkey, ct2: bitstring));
  let ss2 = pqkem_dec(pqae2, ct2) in

  let (ra2: key, ca2: key) = hkdf4(ra1, dh(gtb2, ae2)) in
  let (pqra2: key, pqca2: key) = hkdf3(amaster, ss2) in
  let mak2 = hkdf5(ca2, pqca2) in

  let m2 = aead_dec(mak2, x2, concat3(concat1(PK_A, PK_B), gtb2, ct2)) in
  event recvE2(m2, mak2);

  0.

let PeerB(SK_B: skey, PK_B: pkey, PK_A: pkey) =
  new bo: skey;
  new bs: skey;
  new pqbo: kempriv;

  let gbs = pk(bs) in
  let gbo = pk(bo) in
  let gpqbo = kempk(pqbo) in
  let gbssig = sign(SK_B, rb(gbs)) in
  let gpqbsig = sign(SK_B, qb(gpqbo)) in
  out(c, (gbssig, gbs, gbo, gpqbo, gpqbsig));
  phase 1; (* peer B commits first *)

  (* first stage: derive bmaster, verfiy a's msgs, decrypt prekey message, reply *)

  in(c, (x1: bitstring, gae1: pkey, gae2: pkey, gpqae2: kempub, ct: bitstring));
  let ss = pqkem_dec(pqbo, ct) in

  let bmaster = hkdf1(dh(PK_A, bs), dh(gae1, SK_B), dh(gae1, bs), dh(gae1, bo), ss) in
  let (rb1: key, cb1: key) = hkdf2(bmaster) in (* derive the root and chain key *)

  let m1 = aead_dec(cb1, x1, concat2(concat1(PK_A, PK_B), gae2, gpqae2)) in
  event recvE1(m1, cb1);

  (* second stage *)

  new tb2: skey;
  let gtb2 = pk(tb2) in
  let (ct2: bitstring, ss2: bitstring) = pqkem_enc(gpqae2) in

  let (rb2: key, cb2: key) = hkdf4(rb1, dh(gae2, tb2)) in
  let (pqrb2: key, pqcb2: key) = hkdf3(bmaster, ss2) in
  let mbk2 = hkdf5(cb2, pqcb2) in

  let x2 = aead_enc(mbk2, m2, concat3(concat1(PK_A, PK_B), gtb2, ct2)) in
  event sendE2(m2, mbk2);

  out(c, (x2, gtb2, ct2));

  0.

process
  new SK_A: skey; let PK_A = pk(SK_A) in
  new SK_B: skey; let PK_B = pk(SK_B) in
  out(a, PK_A);
  out(a, PK_B);

  new fib1: skey;
  new fib2: skey;
  let k_A = choice [ SK_A, fib1 ] in
  let k_B = choice [ SK_B, fib2 ] in

  event start();
  ( (PeerA(SK_A, PK_A, pk(k_B))) |
    (PeerB(k_B, pk(k_B), PK_A)) |
    out(a, m1))
