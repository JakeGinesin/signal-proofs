(*
  X3DH; proving authenticity, secrecy, and forward secrecy
  Author: Jake Ginesin
*)

free m1: bitstring [private].
free empty: bitstring.
fun okay():bitstring.

set selFun = Nounifset.   
set ignoreTypes = false.
set redundantHypElim = true.  
set redundancyElim = best.
set movenew = true.
set nounifIgnoreAFewTimes = auto.
(*
set reconstructTrace = false.
set simpEqAll = false. 
set simpEqAll = false. 
set redundancyElim = best.
set redundantHypElim = true.  
set simplifyProcess = true.
set stopTerm = false.
*)

nounif z: skey; attacker(pk(z)) / 10000.
nounif x: pkey, y: skey; attacker(dh(x,y)) / 5000.
nounif z: skey; attacker(pk(z)) phase 1 / 5000.
nounif z: skey; attacker(pk(z)) phase 2 / 5000.
nounif z: skey; attacker(pk(z)) phase 3 / 5000.

free c: channel.
free a: channel. (* channel for the attacker *)

(* Symmetric key encryption *)

type key.

fun aead_enc(key, bitstring, bitstring): bitstring.
reduc forall k: key, m: bitstring, ad: bitstring;
  aead_check(k, aead_enc(k, m, ad), ad) = okay.
reduc forall k: key, m: bitstring, ad: bitstring;
  aead_dec(k, aead_enc(k, m, ad), ad) = m.

(* Asymmetric key encryption *)

type skey.
type pkey.

fun rb(pkey): bitstring [data]. (* translate a public key to a bitstring *)
fun pk(skey): pkey.

(* Digital signatures *)

fun sign(skey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey; checksign(pk(sk), m, sign(sk, m)) = okay.

(* Diffie-Hellman *)
(* DH -> Public^Private *)

fun dh(pkey, skey): key.
equation forall a: skey, b: skey; dh(pk(a), b) = dh(pk(b), a). (* symmetry of DH *)

(* Key derivation functions *)
fun hkdf1(key, key, key, key): key.

fun hkdf2_dev1(key): key.
fun hkdf2_dev2(key): key.
letfun hkdf2(k: key) =
  (hkdf2_dev1(k), hkdf2_dev2(k)).

fun concat1(pkey, pkey): bitstring [data].

(* events *)
event sendE1(bitstring, key).
event recvE1(bitstring, key).

event compromiseSKA(skey).
event compromiseSKB(skey).

event start().

let PeerA(SK_A: skey, PK_A: pkey, PK_B: pkey) =

  new ae1: skey;
  new ae2: skey;
  let gae1 = pk(ae1) in

  (* generate amaster and enc msg (PHASE 1) *)
  phase 1;

  in(c, (gbssig: bitstring, gbs: pkey, gbo: pkey));
  if checksign(PK_B, rb(gbs), gbssig) = okay then 

  let amaster = hkdf1(dh(gbs, SK_A), dh(PK_B, ae1), dh(gbs, ae1), dh(gbo, ae1)) in
  let (_: key, ca1: key) = hkdf2(amaster) in (* derive the root and chain key *)

  let x1 = aead_enc(ca1, m1, concat1(PK_A, PK_B)) in 
  event sendE1(m1, ca1);

  out(c, (x1, gae1));

  0.

let PeerB(SK_B: skey, PK_B: pkey, PK_A: pkey) =
  new bo: skey;
  new bs: skey;

  let gbs = pk(bs) in
  let gbo = pk(bo) in
  let gbssig = sign(SK_B, rb(gbs)) in
  out(c, (gbssig, gbs, gbo));
  phase 1; (* peer B commits first *)

  (* first stage: derive bmaster, verfiy a's msgs, decrypt prekey message, reply *)

  in(c, (x1: bitstring, gae1: pkey)); 
  let bmaster = hkdf1(dh(PK_A, bs), dh(gae1, SK_B), dh(gae1, bs), dh(gae1, bo)) in
  let (_: key, cb1: key) = hkdf2(bmaster) in (* derive the root and chain key *)

  let m1 = aead_dec(cb1, x1, concat1(PK_A, PK_B)) in 
  event recvE1(m1, cb1);

  0.

query event(start()). (* reachable from all possible executions *)

(* forward secrecy *)
query sk1: skey, sk2: skey; (event(compromiseSKA(sk1)) && event(compromiseSKB(sk2)) && attacker(m1)) ==> false.

(* secrecy *)
query attacker(m1). 

(* auth *)
query m: bitstring, rk: key; event(recvE1(m, rk)) ==> event(sendE1(m, rk)).

(* reachability *) 
query m: bitstring, rk: key; event(recvE1(m, rk)). (* reachable from all executions *)
query m: bitstring, rk: key; event(sendE1(m, rk)). (* reachable from all executions *)

process
  new SK_A: skey; let PK_A = pk(SK_A) in 
  new SK_B: skey; let PK_B = pk(SK_B) in
  out(a, PK_A);
  out(a, PK_B);
  event start();
  ( (!PeerA(SK_A, PK_A, PK_B)) |
    (!PeerB(SK_B, PK_B, PK_A)) | 
      (phase 2; event compromiseSKA(SK_A); event compromiseSKB(SK_B); out(a, SK_A); out(a, SK_B))
       )
